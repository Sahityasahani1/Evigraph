# EviGraph backend / API environment
# Copy to .env (gitignored) or inject via your secret manager.

# --- Authentication -------------------------------------------------------
# When set, every /api/* and /incidents* request must send
#   X-API-Key: <value>      or      Authorization: Bearer <value>
# Leave empty ONLY for loopback development; the server refuses to bind a
# non-loopback interface without a key.
EVIGRAPH_API_KEY=

# --- Network --------------------------------------------------------------
EVIGRAPH_HOST=127.0.0.1
EVIGRAPH_PORT=8000

# Comma-separated explicit origins. Never use "*" for forensic data.
EVIGRAPH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Operational limits ---------------------------------------------------
EVIGRAPH_RATE_LIMIT_PER_MINUTE=240
EVIGRAPH_CACHE_TTL_SECONDS=2
EVIGRAPH_ENABLE_DOCS=false

# --- Evidence key custody -------------------------------------------------
# Secret used to derive salted HMAC commitments in privacy proofs.
# If unset, a random key is generated and written to
# outputs/privacy_disclosure_key.secret (0600). NEVER ship that file with the
# certificate. In production, supply this from a KMS/secret manager.
EVIGRAPH_DISCLOSURE_SECRET=
